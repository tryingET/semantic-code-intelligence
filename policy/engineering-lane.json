{
  "engineering_core": {
    "tool": "engineering-core",
    "repository": "https://github.com/tryingET/core_engineering-core",
    "ref": "workspace-local-unpinned",
    "catalog_command": "uv tool -n run --from \"$HOME/ai-society/core/engineering-core\" engineering-core catalog --pretty --prefer-repo",
    "list_disciplines_command": "uv tool -n run --from \"$HOME/ai-society/core/engineering-core\" engineering-core list-disciplines",
    "list_templates_command": "uv tool -n run --from \"$HOME/ai-society/core/engineering-core\" engineering-core list-templates",
    "disciplines": [
      "validation",
      "testing",
      "security-privacy",
      "documentation",
      "dependency-governance",
      "local-first-data",
      "observability",
      "specification-and-dsls",
      "engineering-reasoning",
      "accessibility",
      "design-system"
    ],
    "lanes": [
      {
        "lane": "ts",
        "command": "uv tool -n run --from \"$HOME/ai-society/core/engineering-core\" engineering-core show ts --prefer-repo"
      },
      {
        "lane": "ts-frontend",
        "command": "uv tool -n run --from \"$HOME/ai-society/core/engineering-core\" engineering-core show ts-frontend --prefer-repo"
      }
    ],
    "loop_validation": {
      "version": "repo-loop-validation-v1",
      "contract_doc": "docs/engineering.local.md#repo-loop-validation",
      "commands": {
        "loop-doctor": "just loop-doctor",
        "loop-verify-fast": "just loop-verify-fast",
        "loop-impact-plan": "just loop-impact-plan",
        "loop-impact-run": "just loop-impact-run",
        "loop-impact-wide": "just loop-impact-wide",
        "loop-landing-check": "just loop-landing-check"
      }
    },
    "capability_contract": {
      "version": "engineering-core-capabilities-v1",
      "capabilities": {
        "planning": {
          "status": "declared",
          "schema": "engineering-plan-v1"
        },
        "advisor": {
          "status": "declared",
          "request_schema": "engineering-advice-request-v1",
          "response_schema": "engineering-advice-response-v1"
        }
      }
    },
    "release_pin": {
      "kind": "workspace-local",
      "ref": "workspace-local-unpinned",
      "resolved_commit": null,
      "source": "workspace-local-unpinned"
    }
  }
}

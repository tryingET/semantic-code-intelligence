{
  "mcpServers": {
    "semantic-code-intelligence": {
      "command": "bun",
      "args": ["run", "./dist/mcp/mcp.js"],
      "env": {
        "NODE_ENV": "development",
        "LOG_LEVEL": "debug",
        "SEMANTIC_CODE_DB_PATH": ".ontology/ontology.db",
        "SEMANTIC_CODE_WORKSPACE": "."
      }
    },
    "semantic-code-mcpHTTP": {
      "command": "bun",
      "args": ["run", "./dist/mcp-http/mcp-http.js"],
      "env": {
        "MCP_HTTP_HOST": "localhost",
        "MCP_HTTP_PORT": "7001",
        "SEMANTIC_CODE_INTELLIGENCE_HOST": "localhost",
        "SEMANTIC_CODE_INTELLIGENCE_PORT": "7000",
        "SEMANTIC_CODE_DB_PATH": ".ontology/ontology.db",
        "SEMANTIC_CODE_WORKSPACE": "."
      }
    }
  }
}

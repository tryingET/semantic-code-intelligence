{
  "name": "semantic-code-intelligence",
  "version": "2.0.0",
  "description": "Unified ontology-enhanced code intelligence system with MCP, LSP, and HTTP adapters",
  "type": "module",
  "main": "dist/core/index.js",
  "bin": {
    "sci": "./bin/semantic-code-intelligence",
    "semantic-code-intelligence": "./bin/semantic-code-intelligence",
    "semantic-code-mcp": "./bin/semantic-code-mcp"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tryingET/semantic-code-intelligence"
  },
  "files": [
    "bin/",
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun run build:all",
    "build:all": "rimraf dist && bun run build:core && bun run build:lsp && bun run build:mcp-stdio && bun run build:mcp-http && bun run build:mcp-enhanced && bun run build:http && bun run build:cli",
    "build:core": "bun run scripts/build-server.ts core",
    "build:lsp": "bun run scripts/build-server.ts lsp",
    "build:mcp-stdio": "bun run scripts/build-server.ts mcp-stdio",
    "build:http": "bun run scripts/build-server.ts http",
    "build:cli": "bun run scripts/build-server.ts cli",
    "cli:install-local": "bun run build:cli && bun link",
    "start": "bun run dist/lsp/lsp.js --stdio",
    "start:mcp": "bun run dist/mcp/mcp.js",
    "dev": "bun run src/servers/lsp.ts",
    "test": "scripts/run-normal-tests.sh",
    "test:nonperf": "scripts/run-normal-tests.sh",
    "test:raw": "bun test",
    "test:perf": "PERF=1 bun test tests/performance tests/benchmarks",
    "test:e2e": "E2E=1 bun test tests/e2e",
    "test:mcp": "bun test tests/adapters/mcp.test.ts",
    "test:watch": "bun test --watch",
    "test:coverage": "scripts/run-coverage-tests.sh",
    "command-surface:check": "bun run scripts/check-command-surface.ts",
    "public-surface:check": "bun run build:all && bun run scripts/check-public-runtime-surface.ts",
    "lint": "bunx @biomejs/biome lint --diagnostic-level=error --files-ignore-unknown=true src tests scripts package.json biome.json",
    "lint:warnings": "bunx @biomejs/biome lint --files-ignore-unknown=true src tests scripts package.json biome.json",
    "lint:fix": "bunx @biomejs/biome check --write --files-ignore-unknown=true src tests scripts package.json biome.json",
    "format": "bunx @biomejs/biome format --write .",
    "clean": "rimraf dist",
    "build:mcp-http": "bun run scripts/build-server.ts mcp-http",
    "build:mcp-enhanced": "bun run scripts/build-server.ts mcp-enhanced",
    "prepack": "bun run public-surface:check",
    "alpha:mvp:test": "bun test tests/alpha-mvp-tool-contract.test.ts tests/alpha-mvp-mcp-parity.test.ts tests/alpha-mvp-mcp-http-protocol.test.ts tests/alpha-mvp-mcp-stdio-protocol.test.ts tests/alpha-mvp-cli-parity.test.ts",
    "alpha:mvp:dogfood": "bun run scripts/dogfood-alpha-mvp.ts --json",
    "self:dogfood:cli": "mkdir -p .test-results && bun run scripts/dogfood-self-hosted-cli.ts --json > .test-results/self-hosted-cli-dogfood.json",
    "structural:dogfood": "mkdir -p .test-results && bun run scripts/dogfood-structural-workflow.ts --json >/dev/null",
    "graph:dogfood": "mkdir -p .test-results && bun run scripts/dogfood-graph-impact.ts --json >/dev/null",
    "recommend-checks:dogfood": "mkdir -p .test-results && bun run scripts/dogfood-recommend-checks.ts --json >/dev/null",
    "safe-write:dogfood": "mkdir -p .test-results && bun run scripts/dogfood-safe-write.ts --json >/dev/null",
    "validation-plan:compare": "mkdir -p .test-results && bun run scripts/compare-validation-plans.ts >/dev/null",
    "validation-plan:compare:test": "bun test tests/validation-plan-comparison.test.ts",
    "alpha:evidence:history": "mkdir -p .test-results && bun run scripts/compare-alpha-evidence-history.ts >/dev/null",
    "alpha:evidence:history:test": "bun test tests/alpha-evidence-history.test.ts",
    "alpha:evidence:check:test": "bun test tests/alpha-evidence-check.test.ts",
    "target-validation-plan:dogfood": "mkdir -p .test-results && bun run scripts/dogfood-target-validation-plan.ts --json",
    "target-dogfood:issue": "bun run scripts/capture-target-dogfood-issue.ts",
    "target-dogfood:issue:test": "bun test tests/target-dogfood-issue-capture.test.ts",
    "evidence-review:summary": "bun run scripts/summarize-evidence-review.ts",
    "evidence-review:test": "bun test tests/evidence-review-claim-model.test.ts",
    "alpha:evidence:check": "bun run scripts/check-alpha-evidence.ts > .test-results/alpha-evidence-check.json",
    "alpha:evidence:packet": "bun run scripts/build-alpha-evidence-packet.ts > .test-results/alpha-evidence-packet.json",
    "alpha:evidence:packet:test": "bun test tests/alpha-evidence-packet-summary.test.ts",
    "alpha:mvp:check": "bun run typecheck && bun run command-surface:check && bun run public-surface:check && bun test tests/alpha-mvp-validation-surface.test.ts tests/build-command-surface.test.ts && bun run alpha:mvp:test && bun run evidence-review:test && bun run alpha:evidence:packet:test && bun run alpha:evidence:history:test && bun run alpha:evidence:check:test && bun run validation-plan:compare:test && bun test tests/target-dogfood-issue-capture.test.ts && mkdir -p .test-results && bun run scripts/dogfood-alpha-mvp.ts --json > .test-results/alpha-mvp-dogfood.json && bun run self:dogfood:cli && bun run structural:dogfood && bun run graph:dogfood && bun run recommend-checks:dogfood && bun run safe-write:dogfood && bun run validation-plan:compare && bun run alpha:evidence:check && bun run alpha:evidence:history && bun run alpha:evidence:packet && ./scripts/migration-hygiene.sh",
    "typecheck": "tsgo --project tsconfig.build.json --noEmit --pretty false",
    "typecheck:fallback": "tsc -p tsconfig.build.json"
  },
  "keywords": [
    "lsp",
    "ontology",
    "refactoring",
    "pattern-learning",
    "fuzzy-matching"
  ],
  "author": "tryingET",
  "license": "MIT",
  "dependencies": {
    "@bufbuild/protobuf": "^2.12.0",
    "@c4312/scip": "0.1.0",
    "@modelcontextprotocol/sdk": "^1.17.4",
    "@types/glob": "^9.0.0",
    "bloom-filters": "^3.0.4",
    "chokidar": "^4.0.3",
    "commander": "^14.0.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "glob": "^11.0.3",
    "graphlib": "^2.1.8",
    "js-yaml": "^4.1.0",
    "leven": "^4.0.0",
    "lru-cache": "^11.1.0",
    "minimatch": "^10.0.1",
    "pg": "^8.21.0",
    "tree-sitter": "^0.21.0",
    "tree-sitter-go": "0.21.2",
    "tree-sitter-javascript": "^0.23.1",
    "tree-sitter-python": "^0.23.6",
    "tree-sitter-rust": "0.21.0",
    "tree-sitter-typescript": "^0.23.2",
    "uuid": "^11.1.0",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/graphlib": "^2.1.12",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.20.0",
    "@types/uuid": "^10.0.0",
    "@typescript/native-preview": "^7.0.0-dev.20260509.2",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.2.0"
  },
  "trustedDependencies": [
    "tree-sitter",
    "tree-sitter-go",
    "tree-sitter-javascript",
    "tree-sitter-python",
    "tree-sitter-rust",
    "tree-sitter-typescript"
  ]
}

{
  "mcpServers": {
    "ontology-lsp": {
      "command": "bun",
      "args": ["run", "./dist/mcp/mcp.js"],
      "env": {
        "NODE_ENV": "development",
        "LOG_LEVEL": "debug",
        "ONTOLOGY_DB_PATH": ".ontology/ontology.db",
        "ONTOLOGY_WORKSPACE": "."
      }
    },
    "ontology-mcpHTTP": {
      "command": "bun",
      "args": ["run", "./dist/mcp-http/mcp-http.js"],
      "env": {
        "MCP_HTTP_HOST": "localhost",
        "MCP_HTTP_PORT": "7001",
        "ONTOLOGY_LSP_HOST": "localhost",
        "ONTOLOGY_LSP_PORT": "7000",
        "ONTOLOGY_DB_PATH": ".ontology/ontology.db",
        "ONTOLOGY_WORKSPACE": "."
      }
    }
  }
}
